# Long-lived local pipeline worker: leases runner=="local" queue items from
# Firestore and runs them end-to-end with no Cloud Function handoff.
# Build from the repo root:  docker build -f pipeline_client/Dockerfile.worker -t sv-worker .
FROM python:3.14-slim@sha256:51dafde81dbdb6ebde285137a295cf18a47ca95234fe388a343719cb97305b3d

WORKDIR /app

# The digest pin freezes Debian packages at the base image's build date; take
# security updates so a newly published OS CVE doesn't fail the Trivy gate.
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Reuse the backend requirements (the worker imports the same agent + backend code).
COPY requirements-constraints.txt /tmp/requirements-constraints.txt
COPY pipeline_client/backend/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -c /tmp/requirements-constraints.txt -r /tmp/requirements.txt \
    && pip install --no-cache-dir -c /tmp/requirements-constraints.txt python-dotenv

COPY pipeline_client ./pipeline_client
COPY shared ./shared

RUN useradd --create-home --shell /bin/bash app \
    && chown -R app:app /app
USER app

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Build provenance. Without this the staleness check has nothing to compare and
# a container built before a fix silently keeps claiming work. docker-compose
# passes the current commit; a bare `docker build` leaves it unset, which the
# worker reports as unknown rather than assuming it is current.
ARG WORKER_GIT_COMMIT=""
ENV WORKER_GIT_COMMIT=${WORKER_GIT_COMMIT}

# Long-lived poller by default; Cloud Run Jobs override env with WORKER_ONCE=true.
ENTRYPOINT ["python", "-m", "pipeline_client.worker"]
